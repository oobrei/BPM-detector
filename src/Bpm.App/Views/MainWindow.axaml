<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Bpm.App.Controls"
        x:Class="Bpm.App.Views.MainWindow"
        Title="BPM Detector"
        Width="880" Height="500"
        MinWidth="740" MinHeight="430"
        Background="#0F1216"
        FontFamily="Inter, Segoe UI"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#1C2128"/>
      <Setter Property="Foreground" Value="#D7DEE7"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#232B34"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1F6FEB"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1F6FEB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#388BFD"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#8B949E"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#161B22"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A2027"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C3A5E"/>
    </Style>

    <!-- Row actions: invisible until the row is hovered, but always laid out so the row
         does not shift when they appear. -->
    <Style Selector="Button.rowAction">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Width" Value="21"/>
      <Setter Property="Height" Value="21"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.rowAction">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A323C"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#161B22" Padding="8,5"
            BorderBrush="#30363D" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="FileMenuButton" Content="File ▾">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Add Files…" Click="OnAddFiles"/>
              <MenuItem Header="Add Folder…" Click="OnAddFolder"/>
              <Separator/>
              <MenuItem Header="Export CSV…" Click="OnExport"/>
              <Separator/>
              <MenuItem Header="Clear List" Click="OnClear"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Classes="primary" Name="RescanButton" Content="Rescan BPM" Click="OnRescan"/>
        <Button Name="RescanPendingButton" Content="Scan Unanalyzed" Click="OnRescanPending"/>
        <CheckBox Name="AutoScanCheck" Content="Auto-scan" IsChecked="{Binding AutoScan}"
                  FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#161B22" Padding="8,4"
            BorderBrush="#30363D" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,220" ColumnSpacing="8">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                   Foreground="#B8C2CC" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}"
                     Height="8" CornerRadius="4" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,300" Margin="8" ColumnSpacing="8">

      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
        <Grid ColumnDefinitions="2.4*,0.7*,0.8*,0.9*,47" Margin="8,0,8,0">
          <TextBlock Text="FILE" Classes="label"/>
          <TextBlock Grid.Column="1" Text="LENGTH" Classes="label"/>
          <TextBlock Grid.Column="2" Text="BPM" Classes="label"/>
          <TextBlock Grid.Column="3" Text="STATUS" Classes="label"/>
        </Grid>

        <Border Grid.Row="1" Padding="0,2">
          <ListBox Name="FileList" SelectionMode="Multiple" ItemsSource="{Binding Files}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="2.4*,0.7*,0.8*,0.9*,47">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding IdDisplay}" FontSize="10" FontFamily="Consolas, Inter"
                                 Foreground="#5B6672" VerticalAlignment="Center" Margin="0,0,5,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="#E6EDF3"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <TextBlock Text="{Binding Folder}" Classes="hint" FontSize="10"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}" FontSize="11"
                             VerticalAlignment="Center" Foreground="#B8C2CC"/>
                  <TextBlock Grid.Column="2" Text="{Binding BpmDisplay}" FontSize="13"
                             FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="#56D4F5" FontFamily="Consolas, Inter"/>
                  <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                             VerticalAlignment="Center" Foreground="#8B949E"
                             TextTrimming="CharacterEllipsis"/>

                  <!-- Lucide icons (shadcn/ui's icon set), 24x24 geometry at 2px stroke. -->
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="1"
                              VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="rowAction" Click="OnCancelRow" Tag="{Binding Id}"
                            ToolTip.Tip="Cancel this file">
                      <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                          <Path Stroke="#8B949E" StrokeThickness="2" StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Data="M18 6 L6 18 M6 6 L18 18"/>
                        </Canvas>
                      </Viewbox>
                    </Button>
                    <Button Classes="rowAction" Click="OnRemoveRow" Tag="{Binding Id}"
                            ToolTip.Tip="Remove from list">
                      <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <!-- A fixed 24x24 canvas gives both icons the same coordinate space, so
                             they scale by one identical factor and centre identically. -->
                        <Canvas Width="24" Height="24">
                          <Path Stroke="#8B949E" StrokeThickness="2" StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Data="M10 11 L10 17 M14 11 L14 17 M19 6 L19 20 A2 2 0 0 1 17 22 L7 22 A2 2 0 0 1 5 20 L5 6 M3 6 L21 6 M8 6 L8 4 A2 2 0 0 1 10 2 L14 2 A2 2 0 0 1 16 4 L16 6"/>
                        </Canvas>
                      </Viewbox>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D"
              BorderThickness="1" CornerRadius="6" Padding="10,8">
        <StackPanel>
          <TextBlock Text="TEMPO" Classes="label"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding SelectedBpmDisplay}" FontFamily="Consolas, Inter"
                       FontSize="40" FontWeight="Bold" Foreground="#E6EDF3"/>
            <TextBlock Text="BPM" Classes="hint" FontSize="12" VerticalAlignment="Bottom"
                       Margin="0,0,0,7"/>
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                Margin="0,4,0,0" ColumnSpacing="8">
            <TextBlock Text="CONFIDENCE" Classes="label" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectedConfidenceDisplay}" FontSize="11"
                       FontFamily="Consolas, Inter" Foreground="#D7DEE7" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="LENGTH" Classes="label" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDurationDisplay}"
                       FontSize="11" FontFamily="Consolas, Inter" Foreground="#D7DEE7"
                       HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="METHOD" Classes="label" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMethodDisplay}"
                       FontSize="11" FontFamily="Consolas, Inter" Foreground="#56D4F5"
                       HorizontalAlignment="Right"/>
          </Grid>

          <TextBlock Text="ONSET ENERGY · BEAT GRID" Classes="label" Margin="0,10,0,3"/>
          <controls:OnsetGraphControl Height="140" Curve="{Binding SelectedOdf}"
                                      Ticks="{Binding SelectedTicks}"
                                      FrameRate="{Binding SelectedFrameRate}"/>
          <TextBlock Text="orange = beats · Ctrl+wheel zoom · drag to move" Classes="label"
                     FontSize="9.5" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
